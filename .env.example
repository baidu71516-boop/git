# Runtime
APP_ENV=development
APP_PORT=8080
APP_NAME=influencer-outreach
APP_VERSION=0.1.0
APP_MASTER_KEY=GENERATE_ME
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=Asia/Shanghai

# PostgreSQL (local development values must be replaced/generated)
POSTGRES_DB=outreach
POSTGRES_USER=outreach
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgresql+psycopg://outreach:GENERATE_ME@postgres:5432/outreach

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Import storage
IMPORT_DATA_DIR=/data/imports
IMPORT_RETENTION_DAYS=30

# Browser-visible API prefix; never place secrets in NEXT_PUBLIC variables
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Reserved for later phases; leave empty in Phase 0
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

