# Runtime
APP_ENV=development
APP_PORT=8080
APP_NAME=influencer-outreach
APP_VERSION=0.1.0
APP_MASTER_KEY=GENERATE_ME
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=Asia/Shanghai

# Authentication (fixed product defaults; production enables Secure cookies via APP_ENV)
SESSION_COOKIE_NAME=outreach_session
CSRF_COOKIE_NAME=outreach_csrf
SESSION_DEFAULT_HOURS=12
SESSION_REMEMBER_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# PostgreSQL (local development values must be replaced/generated)
POSTGRES_DB=outreach
POSTGRES_USER=outreach
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgresql+psycopg://outreach:GENERATE_ME@postgres:5432/outreach

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Import storage
IMPORT_DATA_DIR=/data/imports
IMPORT_RETENTION_DAYS=30
IMPORT_MAX_FILE_BYTES=26214400
IMPORT_MAX_XLSX_UNCOMPRESSED_BYTES=104857600
IMPORT_MAX_XLSX_ENTRIES=10000
IMPORT_MAX_XLSX_COMPRESSION_RATIO=100
IMPORT_MAX_ROWS=100000
IMPORT_MAX_COLUMNS=200
IMPORT_MAX_CELLS=5000000
IMPORT_MAX_CELL_CHARS=100000
IMPORT_MAX_WARNINGS=10000

# Browser-visible API prefix; never place secrets in NEXT_PUBLIC variables
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Reserved for later phases; leave empty in Phase 0
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
